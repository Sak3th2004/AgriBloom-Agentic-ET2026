# AgriBloom Agentic — Environment Configuration Template
# Copy this to .env and fill in your keys. NEVER commit the real .env.
# Every provider below has a FREE tier; none are required to run in offline mode.

# ─── LLM providers (reasoning / vision / treatment). Priority: NVIDIA → Gemini → Ollama ───
# Google Gemini (FREE — https://aistudio.google.com/apikey). Rotation-capable.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# NVIDIA NIM (FREE — https://build.nvidia.com). Multiple keys enable smart rotation.
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# Groq (FREE — https://console.groq.com/keys). Used for fast reasoning + Whisper STT in V2.
GROQ_API_KEY=

# Ollama local server (no key needed; install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Weather ───
# OpenWeatherMap (FREE — https://openweathermap.org/api). Falls back to Open-Meteo (no key).
OPENWEATHER_API_KEY=

# ─── Model paths / runtime ───
AGRIBLOOM_VISION_MODEL_DIR=models/checkpoints/efficientnet_b4_indian
AGRIBLOOM_OFFLINE_DEFAULT=false
# Ollama's local TEXT model (used as the last fallback in genai_handler).
# Default matches what's already pulled locally; override if you use a
# different tag. See `ollama list`.
AGRIBLOOM_OLLAMA_TEXT_MODEL=qwen3.5:9b

# ─── Backend API (Phase 6) ───
# Comma-separated allowed origins for the FastAPI backend's CORS. "*" is fine
# for local dev; set to your real Vercel URL in production.
AGRIBLOOM_CORS_ORIGINS=*

# ─── V2 (added incrementally; safe to leave blank until those phases) ───
# Qdrant vector DB (FREE self-host or 1GB cloud — https://cloud.qdrant.io)
QDRANT_URL=
QDRANT_API_KEY=
# Langfuse open-source observability (FREE self-host — https://langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
