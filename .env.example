# AgriBloom - Environment Configuration Template
# Copy this to .env and fill in your API keys

# LLM provider order for treatment text and follow-up answers.
# Supported: nvidia, openai, openai_compatible, gemini, ollama
AGRIBLOOM_LLM_ORDER=nvidia,openai,openai_compatible,gemini,ollama

# NVIDIA API
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# OpenAI API
# Set both key and model. No default model is forced by the app.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Grok/xAI, hosted vLLM, LiteLLM, or any OpenAI-compatible endpoint
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.0-flash

# LLM runtime controls
AGRIBLOOM_LLM_MAX_TOKENS=1600
AGRIBLOOM_LLM_TEMPERATURE=0.3
AGRIBLOOM_LLM_TIMEOUT_SECONDS=30

# Model paths
AGRIBLOOM_VISION_MODEL_DIR=models/checkpoints/efficientnet_b4_indian

# Offline mode default (true/false)
AGRIBLOOM_OFFLINE_DEFAULT=false
