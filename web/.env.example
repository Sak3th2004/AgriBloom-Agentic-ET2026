# AgriBloom V2 frontend — environment template
#
# Base URL of the AgriBloom REST API (FRONTEND_PLAN.md §6 contract).
#   ""  (empty)          -> use the built-in mock API served by this Next.js app
#   https://<space>.hf.space -> the real FastAPI backend once it is live
NEXT_PUBLIC_API_BASE_URL=

# Public URL of the deployed app (used for Open Graph / social link previews).
NEXT_PUBLIC_APP_URL=https://agribloom.vercel.app
